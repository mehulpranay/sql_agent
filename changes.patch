+# Limits that keep one question from using unlimited time, memory or tokens.
+MAX_SECONDS = float(os.environ.get('MAX_SECONDS', '90'))   # whole question, all turns together
+LLM_TIMEOUT_S = 30                  # one call to the model; the SDK retries transient failures twice
+MAX_ROWS = 1000                     # rows read from the database per query (the model still sees 10)
+MAX_OBSERVATION_CHARS = 4000        # longest tool result we put into the model's context
+
+
+def limit_text(text, limit=MAX_OBSERVATION_CHARS):
+    """Cut a tool result to `limit` characters so one huge cell or list cannot flood the context."""
+    text = str(text)
+    if len(text) <= limit:
+        return text
+    return text[:limit] + f' ...(cut: {len(text) - limit} more characters)'
+
 
